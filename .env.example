APP_NAME="نظام إدارة المخاطر"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# قاعدة البيانات — Oracle هي قاعدة الإنتاج الرسمية لهذا النظام.
# استخدم DB_CONNECTION=sqlite فقط للتجربة السريعة محلياً بدون Oracle Client.
# ---------------------------------------------------------------------------
DB_CONNECTION=oracle
DB_HOST=127.0.0.1
DB_PORT=1521
DB_DATABASE=ORCL
DB_SERVICE_NAME=ORCLPDB1
DB_USERNAME=risk_mgmt
DB_PASSWORD=
DB_CHARSET=AL32UTF8

DB_HOST_NEWPO=192.168.161.89
DB_PORT_NEWPO=3306
DB_DATABASE_NEWPO=new_po
DB_USERNAME_NEWPO=amgad
DB_PASSWORD_NEWPO=Amgad@123

# كود القطاع المركزي للمخاطر في new_po (يُضاف تلقائياً للقطاعات المسؤولة عن الحدث). اتركه فاضي لو مش مطلوب.
RISK_CENTRAL_SECTOR_CODE=

# ---------------------------------------------------------------------------
# تسجيل الدخول عبر LDAP (Active Directory) — نفس خوادم نظام خدمة العملاء.
# يتطلب تفعيل امتداد PHP "ldap" (php_ldap) في php.ini، ويعمل فقط عند الاتصال
# بشبكة الجهاز الداخلية (أو VPN) القادرة على الوصول لهذه العناوين.
# ---------------------------------------------------------------------------
LDAP_HOSTS=192.168.161.100,192.168.161.131,192.168.161.201
LDAP_PORT=389
LDAP_DOMAIN_PREFIX=sfd

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@msmeda.org.eg"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
